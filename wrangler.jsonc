{
  "name": "sourdough-calc",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "ENFORCE_CANONICAL_HOST": "1"
  },
  "env": {
    "preview": {
      "name": "sourdough-calc-preview",
      "compatibility_date": "2026-11-17",
      "vars": {
        "NOINDEX": "1"
      }
    }
  }
}
